{
  "name": "oh-io-vn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev --local-upstream localhost:8787 --upstream-protocol http",
    "build:web": "node scripts/generate-pages.mjs && vite build",
    "build": "npm run typecheck && npm run build:web && wrangler deploy --dry-run --outdir .local/worker-build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run && node --test tests/*.node.test.mjs",
    "test:security": "vitest run tests/security.test.ts tests/oauth-security.test.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:secrets": "node scripts/security-scan.mjs",
    "db:local": "wrangler d1 migrations apply oh-io-vn --local",
    "db:remote": "wrangler d1 migrations apply oh-io-vn --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide": "1.59.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
