{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oh-io-vn",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"],
    "not_found_handling": "none",
    "html_handling": "force-trailing-slash",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oh-io-vn",
      "database_id": "db864506-012b-4e87-bc1a-e0190d114527",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "BURST",
      "namespace_id": "1001",
      "simple": {
        "limit": 15,
        "period": 60,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPIRY_GUARD",
        "class_name": "ExpiryGuard",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExpiryGuard"],
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://oh.io.vn",
    "GOOGLE_CLIENT_ID": "669212415337-a1q8mo3amc0ptjsia4jpk6j3dqpr429m.apps.googleusercontent.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFZNp3mSXTGgy8_g",
    "ADMIN_GOOGLE_SUBS": "",
    "CF_ACCOUNT_ID": "db4085e11726e7ae060bf624f8f44a8e",
    "CF_DATABASE_ID": "db864506-012b-4e87-bc1a-e0190d114527",
  },
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": {
      "invocation_logs": false,
    },
  },
  "routes": [
    {
      "pattern": "oh.io.vn",
      "custom_domain": true,
    },
  ],
}
